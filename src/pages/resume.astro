---
import { Content as Resume } from '../content/resume.md';
import { SITE } from '../config/site';
import Layout from '../layouts/Layout.astro';

const description = 'Resume for Tyler Chambers, Senior Backend and Infrastructure Engineer.';
---

<Layout title={`Resume — ${SITE.name}`} description={description}>
  <header class="resume-header">
    <nav class="site-header__links" aria-label="Resume links">
      <a href="/">← index</a>
      <a href="/Tyler-Chambers-Resume.md" download>Download Markdown</a>
    </nav>
  </header>

  <article class="resume">
    <Resume />
  </article>
</Layout>

<style>
  .resume-header .site-header__links {
    margin-top: 0;
  }

  .resume :global(h3) {
    margin-bottom: 0;
  }

  .resume :global(h3 + p) {
    margin-top: 0.25rem;
  }
</style>
